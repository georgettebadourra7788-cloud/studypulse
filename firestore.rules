rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Plan changes are trusted client-side only for this v1 (no billing
      // integration yet) - everything else about the user doc is owner-only.
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /studies/{studyId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;

      match /uploads/{uploadId} {
        allow read, write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/studies/$(studyId)).data.ownerId;
      }
    }
  }
}
